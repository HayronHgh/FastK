{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastk.local/schemas/release_manifest.schema.json",
  "title": "FastK Release Manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "target",
    "git_commit",
    "rustc",
    "cargo",
    "build_time_utc",
    "artifacts",
    "stable_surfaces",
    "experimental_surfaces"
  ],
  "additionalProperties": false,
  "properties": {
    "name": { "const": "fastk" },
    "version": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "git_commit": { "type": "string", "minLength": 1 },
    "rustc": { "type": "string", "minLength": 1 },
    "cargo": { "type": "string", "minLength": 1 },
    "build_time_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["binary", "crate", "document", "schema"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "stable_surfaces": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "experimental_surfaces": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
